# BSC Fantasy — local development
#
# Copy Firebase env from apps/web or apps/tracker `.env.local`, then add:
# NEXT_PUBLIC_WEB_URL=http://localhost:3000
#
# On Vercel (Fantasy project), set the same Firebase vars as Tracker,
# plus NEXT_PUBLIC_WEB_URL=https://your-main-site-domain
# and (on the main web project) NEXT_PUBLIC_FANTASY_URL=https://fantasy.your-domain
